GROQ_API_KEY=

# Optional but recommended for production: per-IP rate limiting on /api/chat
# and /api/summary. Without these two set, the app falls back to an in-process
# memory limiter that only protects a single long-lived server (fine for local
# dev, not real protection on serverless with multiple instances). On Vercel,
# add the Upstash Redis integration from the Storage tab — it fills these in
# for you automatically. https://vercel.com/marketplace/upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Premium voice (paid subscription) ---------------------------------
# Everything below is only needed for the paid realistic-voice feature.
# Without it the app still runs; it just uses the free browser voice.

# Neon Postgres connection string (https://neon.tech, free tier).
# Copy the "pooled" connection string from the Neon dashboard.
DATABASE_URL=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
# Google OAuth credentials (https://console.cloud.google.com -> APIs &
# Services -> Credentials -> OAuth client ID -> Web application).
# Authorised redirect URI must be:
#   http://localhost:3000/api/auth/callback/google   (local)
#   https://YOUR-DOMAIN/api/auth/callback/google     (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe. Use test-mode keys while developing.
STRIPE_API_KEY=
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the webhook endpoint's signing secret in
# the Stripe dashboard for production. Without it the webhook rejects
# everything — which is correct, since the signature is the only thing
# stopping a forged "subscription active" event.
STRIPE_WEBHOOK_SECRET=

# OpenAI key for the premium voice (gpt-4o-mini-tts). Needs billing enabled
# on the account -- it's pay-as-you-go, not a separate subscription purchase.
OPENAI_API_KEY=
